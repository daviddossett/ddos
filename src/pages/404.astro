---
import Footer from "../components/Footer.astro";
import Layout from "../layouts/Layout.astro";
---

<Layout
  title="Page not found | David Dossett"
  description="The requested page could not be found."
  noindex
>
  <main>
    <section class="not-found-section" aria-labelledby="not-found-heading">
      <h1 id="not-found-heading" class="section-title">Page not found</h1>
      <div class="intro-copy">
        <p>
          The page you&apos;re looking for may have moved or no longer exists.
        </p>
      </div>
      <a class="entry entry-row entry-link not-found-link" href="/">
        <span class="entry-title">Return home</span>
        <span class="entry-description">View selected work and experience</span>
      </a>
    </section>
  </main>
  <Footer />
</Layout>
