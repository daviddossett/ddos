---
import Footer from "../components/Footer.astro";
import Layout from "../layouts/Layout.astro";
---

<Layout
  title="Page not found | David Dossett"
  description="The page you requested could not be found."
  noindex
>
  <main>
    <section class="not-found-section" aria-labelledby="not-found-heading">
      <p class="not-found-code" aria-hidden="true">404</p>
      <h1 id="not-found-heading" class="section-title">Page not found</h1>
      <div class="intro-copy">
        <p>That address doesn&apos;t point to a page on this site.</p>
        <p><a href="/">Return to the homepage</a> to view my work and experience.</p>
      </div>
    </section>
  </main>
  <Footer />
</Layout>
