---
import Footer from "../components/Footer.astro";
import Layout from "../layouts/Layout.astro";
---

<Layout
  title="404: Page not found"
  description="This page could not be found."
  noindex
>
  <main>
    <section class="intro-section" aria-labelledby="not-found-heading">
      <h1 id="not-found-heading" class="section-title">Page not found</h1>
      <div class="intro-copy">
        <p>
          There&apos;s nothing at this address. The link may be broken, or the
          page may have moved.
        </p>
        <p><a href="/">Go to the homepage</a></p>
      </div>
    </section>
  </main>
  <Footer />
</Layout>
