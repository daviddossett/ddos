---
import Footer from "../components/Footer.astro";
import Layout from "../layouts/Layout.astro";
---

<Layout
  title="Page not found | David Dossett"
  description="The page you requested could not be found."
  noindex
>
  <main>
    <section aria-labelledby="not-found-heading">
      <h1 id="not-found-heading" class="section-title">Page not found</h1>
      <div class="intro-copy">
        <p>
          This address doesn&apos;t point to a page on the site. Return home to
          browse my work and experience, or jump directly to selected projects.
        </p>
      </div>

      <nav class="not-found-actions" aria-label="Page recovery">
        <ul class="entry-list">
          <li>
            <a class="entry entry-row entry-link" href="/">
              <span class="entry-title">Return home</span>
              <span class="entry-description">
                Browse my work and experience
              </span>
            </a>
          </li>
          <li>
            <a class="entry entry-row entry-link" href="/#projects-heading">
              <span class="entry-title">Browse projects</span>
              <span class="entry-description">Jump to selected work</span>
            </a>
          </li>
        </ul>
      </nav>
    </section>
  </main>
  <Footer />
</Layout>
