---
// Runs before first paint so the page never flashes the wrong theme.
// data-theme always holds the resolved theme. localStorage only holds an
// explicit choice; without one, the system preference is followed live.
---

<script is:inline>
  (() => {
    const root = document.documentElement;
    const media = matchMedia("(prefers-color-scheme: dark)");
    const stored = () => {
      try {
        const value = localStorage.getItem("theme");
        return value === "light" || value === "dark" ? value : null;
      } catch {
        return null;
      }
    };
    const apply = () => {
      root.dataset.theme = stored() ?? (media.matches ? "dark" : "light");
    };
    apply();
    media.addEventListener("change", apply);
    addEventListener("storage", (event) => {
      if (event.key === "theme" || event.key === null) apply();
    });
  })();
</script>
