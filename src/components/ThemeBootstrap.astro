<script is:inline>
  (function () {
    var key = "ddossett-theme";
    var themes = ["light", "dark", "high-contrast", "lagoon", "sunset"];
    var stored = null;
    try {
      stored = localStorage.getItem(key);
    } catch (e) {}
    var theme =
      themes.indexOf(stored) >= 0
        ? stored
        : window.matchMedia("(prefers-color-scheme: dark)").matches
          ? "dark"
          : "light";
    document.documentElement.setAttribute("data-theme", theme);
  })();
</script>
