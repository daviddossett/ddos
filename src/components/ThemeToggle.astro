<button
  type="button"
  class="theme-toggle"
  aria-label="Dark mode"
  aria-pressed="false"
  data-theme-toggle
>
  <svg
    class="theme-toggle-icon"
    viewBox="0 0 24 24"
    width="18"
    height="18"
    aria-hidden="true"
    focusable="false"
  >
    <mask id="theme-toggle-mask">
      <rect width="24" height="24" fill="white"></rect>
      <circle class="theme-toggle-eclipse" cx="17" cy="7" r="7" fill="black"
      ></circle>
    </mask>
    <circle
      class="theme-toggle-core"
      cx="12"
      cy="12"
      r="9"
      fill="currentColor"
      mask="url(#theme-toggle-mask)"></circle>
    <g
      class="theme-toggle-rays"
      stroke="currentColor"
      stroke-width="2"
      stroke-linecap="round"
    >
      <line x1="12" y1="2.5" x2="12" y2="4.5"></line>
      <line x1="12" y1="19.5" x2="12" y2="21.5"></line>
      <line x1="2.5" y1="12" x2="4.5" y2="12"></line>
      <line x1="19.5" y1="12" x2="21.5" y2="12"></line>
      <line x1="5.28" y1="5.28" x2="6.7" y2="6.7"></line>
      <line x1="17.3" y1="17.3" x2="18.72" y2="18.72"></line>
      <line x1="5.28" y1="18.72" x2="6.7" y2="17.3"></line>
      <line x1="17.3" y1="6.7" x2="18.72" y2="5.28"></line>
    </g>
  </svg>
</button>

<script>
  const STORAGE_KEY = "theme";
  const root = document.documentElement;
  const systemDark = window.matchMedia("(prefers-color-scheme: dark)");
  const button = document.querySelector<HTMLButtonElement>(
    "[data-theme-toggle]",
  );

  type Theme = "light" | "dark";

  const systemTheme = (): Theme => (systemDark.matches ? "dark" : "light");
  const currentTheme = (): Theme =>
    root.dataset.theme === "light" || root.dataset.theme === "dark"
      ? root.dataset.theme
      : systemTheme();

  const syncButton = () => {
    button?.setAttribute("aria-pressed", String(currentTheme() === "dark"));
  };

  const applyChoice = (theme: string | null) => {
    if (theme === "light" || theme === "dark") {
      root.dataset.theme = theme;
    } else {
      delete root.dataset.theme;
    }
    syncButton();
  };

  button?.addEventListener("click", () => {
    const next: Theme = currentTheme() === "dark" ? "light" : "dark";
    // Choosing the system theme clears the override so future system changes apply.
    const choice = next === systemTheme() ? null : next;
    applyChoice(choice);
    try {
      if (choice) {
        localStorage.setItem(STORAGE_KEY, choice);
      } else {
        localStorage.removeItem(STORAGE_KEY);
      }
    } catch {}
  });

  systemDark.addEventListener("change", syncButton);
  window.addEventListener("storage", (event) => {
    if (event.key === STORAGE_KEY) applyChoice(event.newValue);
  });

  syncButton();
</script>
