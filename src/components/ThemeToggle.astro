<fieldset class="theme-toggle">
  <legend class="visually-hidden">Theme</legend>
  <span class="theme-toggle-thumb" aria-hidden="true"></span>
  <label class="theme-option theme-option-light" title="Light">
    <input class="visually-hidden" type="radio" name="theme" value="light" />
    <svg
      aria-hidden="true"
      width="16"
      height="16"
      viewBox="0 0 16 16"
      fill="none"
      stroke="currentColor"
      stroke-width="1.5"
      stroke-linecap="round"
    >
      <circle cx="8" cy="8" r="2.75"></circle>
      <path
        d="M8 1.25v1.5M8 13.25v1.5M1.25 8h1.5M13.25 8h1.5M3.23 3.23l1.06 1.06M11.71 11.71l1.06 1.06M3.23 12.77l1.06-1.06M11.71 4.29l1.06-1.06"
      ></path>
    </svg>
    <span class="visually-hidden">Light</span>
  </label>
  <label class="theme-option theme-option-system" title="System">
    <input
      class="visually-hidden"
      type="radio"
      name="theme"
      value="system"
      checked
    />
    <svg
      aria-hidden="true"
      width="16"
      height="16"
      viewBox="0 0 16 16"
      fill="none"
      stroke="currentColor"
      stroke-width="1.5"
      stroke-linecap="round"
      stroke-linejoin="round"
    >
      <rect x="1.75" y="2.25" width="12.5" height="8.75" rx="1.5"></rect>
      <path d="M5.5 14h5M8 11v3"></path>
    </svg>
    <span class="visually-hidden">System</span>
  </label>
  <label class="theme-option theme-option-dark" title="Dark">
    <input class="visually-hidden" type="radio" name="theme" value="dark" />
    <svg
      aria-hidden="true"
      width="16"
      height="16"
      viewBox="0 0 16 16"
      fill="none"
      stroke="currentColor"
      stroke-width="1.5"
      stroke-linejoin="round"
    >
      <path d="M13.75 9.6A5.75 5.75 0 1 1 6.4 2.25a4.6 4.6 0 0 0 7.35 7.35Z"
      ></path>
    </svg>
    <span class="visually-hidden">Dark</span>
  </label>
</fieldset>

<script>
  type ThemeChoice = "light" | "system" | "dark";

  const STORAGE_KEY = "theme";
  const root = document.documentElement;

  const isThemeChoice = (value: unknown): value is ThemeChoice =>
    value === "light" || value === "system" || value === "dark";

  const currentChoice = (): ThemeChoice => {
    const theme = root.dataset.theme;
    return theme === "light" || theme === "dark" ? theme : "system";
  };

  const applyChoice = (choice: ThemeChoice) => {
    if (choice === "system") {
      delete root.dataset.theme;
    } else {
      root.dataset.theme = choice;
    }

    for (const input of document.querySelectorAll<HTMLInputElement>(
      '.theme-toggle input[name="theme"]',
    )) {
      input.checked = input.value === choice;
    }
  };

  applyChoice(currentChoice());

  document.addEventListener("change", (event) => {
    const input = event.target;
    if (
      !(input instanceof HTMLInputElement) ||
      !input.closest(".theme-toggle") ||
      !isThemeChoice(input.value)
    ) {
      return;
    }

    applyChoice(input.value);
    try {
      if (input.value === "system") {
        localStorage.removeItem(STORAGE_KEY);
      } else {
        localStorage.setItem(STORAGE_KEY, input.value);
      }
    } catch {}
  });

  // Keep other open tabs in sync.
  window.addEventListener("storage", (event) => {
    if (event.key === STORAGE_KEY) {
      applyChoice(isThemeChoice(event.newValue) ? event.newValue : "system");
    }
  });
</script>
