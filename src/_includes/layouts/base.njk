{%- set pageTitle = title or site.title -%}
{%- set pageDescription = description or site.description -%}
{%- if eleventy.env.runMode == "serve" %}{% set pageTitle = pageTitle + " (Dev)" %}{% endif -%}
<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{{ pageTitle }}</title>
    <meta name="description" content="{{ pageDescription }}" />

    <meta property="og:title" content="{{ pageTitle }}" />
    <meta property="og:description" content="{{ pageDescription }}" />
    <meta property="og:type" content="website" />
    <meta property="og:url" content="{{ page.url | absoluteUrl(site.url) }}" />

    <meta name="twitter:card" content="summary" />
    <meta name="twitter:title" content="{{ pageTitle }}" />
    <meta name="twitter:description" content="{{ pageDescription }}" />

    <link rel="icon" type="image/png" sizes="64x64" href="/favicon.png" />
    <link
      rel="preload"
      href="/fonts/InterVariable.woff2"
      as="font"
      type="font/woff2"
      crossorigin
    />
    {% inlineStyles %}
  </head>
  <body>
    <div class="site-shell">
      {% include "partials/header.njk" %}
      {{ content | safe }}
    </div>
  </body>
</html>
